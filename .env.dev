# Shared development settings, used when SMOKE_ENV=dev (e.g. `uv run poe dev`).
# Committed to git: no secrets here. Personal keys go to .env.dev.local (git-ignored).
# Precedence: real environment variables > .env.dev.local > .env.dev.
# All are required.

# Project settings (smoke_watch.config)
SMOKE_DATABASE_URL=postgresql+psycopg://smoke:smoke@localhost:5432/smoke
SMOKE_S3_ENDPOINT_URL=http://localhost:8333

# Local SeaweedFS from docker-compose (read by boto3)
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev

# Local Prefect server from docker-compose
PREFECT_API_URL=http://localhost:4200/api

# Atmosphere Data Store (CAMS), read by cdsapi
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata (read by earthaccess)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# FIRMS credentials
SMOKE_FIRMS_MAP_KEY=

# Copernicus Data Space (Sentinel-5P, Sentinel-2)
SMOKE_CDSE_CLIENT_ID=
SMOKE_CDSE_SECRET=
